{
  "name": "mellah-pos",
  "version": "1.0.1",
  "description": "MELLAH POS — Professional offline-first Point-of-Sale for Algerian retail stores",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/userkxm00/Mellah-POS-V2.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish always",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.110.8",
    "@types/jsbarcode": "^3.11.4",
    "bcryptjs": "^3.0.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.4.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.26.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^3.10.0",
    "sql.js": "^1.14.1",
    "uuid": "^14.0.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^43.4.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "to-ico": "^1.1.5",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.mellah.pos",
    "productName": "MellahPOS",
    "publish": {
      "provider": "github",
      "owner": "userkxm00",
      "repo": "Mellah-POS-V2"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "build/**/*",
      "database/migrations/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mellah POS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer_sidebar.bmp",
      "uninstallerSidebar": "build/installer_sidebar.bmp"
    }
  },
  "packageManager": "pnpm@10.32.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
