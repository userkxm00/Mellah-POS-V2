{
  "name": "mellah-pos",
  "version": "1.0.1",
  "description": "MELLAH POS — Professional offline-first Point-of-Sale for Algerian retail stores",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/userkxm00/Mellah-POS-V2.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "release": "electron-vite build && electron-builder --win --publish always",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.3",
    "@types/jsbarcode": "^3.11.4",
    "bcryptjs": "^3.0.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.4.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2",
    "uuid": "^11.1.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.0",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "to-ico": "^1.1.5",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimist": "^1.2.8",
      "form-data": "^4.0.2",
      "tough-cookie": "^4.1.4",
      "tar": "^7.5.21",
      "node-tar": "^7.5.21",
      "extract-zip": "^2.0.1",
      "@electron/get>extract-zip": "^2.0.1",
      "builder-util-runtime": "^9.3.0",
      "app-builder-lib": "^26.15.0",
      "electron-builder>app-builder-lib": "^26.15.0",
      "postcss": "^8.5.3",
      "decompress": "^4.2.1",
      "unzipper": "^0.12.3",
      "fast-xml-parser": "^4.5.1",
      "http-proxy": "^1.18.1",
      "esbuild": "^0.25.0",
      "qs": "^6.14.1",
      "uuid": "^11.1.1",
      "request": "npm:@cypress/request@^3.0.0"
    }
  },
  "build": {
    "appId": "com.mellah.pos",
    "productName": "MellahPOS",
    "publish": {
      "provider": "github",
      "owner": "userkxm00",
      "repo": "Mellah-POS-V2"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "build/**/*",
      "database/migrations/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mellah POS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer_sidebar.bmp",
      "uninstallerSidebar": "build/installer_sidebar.bmp"
    }
  },
  "packageManager": "pnpm@10.32.0"
}
